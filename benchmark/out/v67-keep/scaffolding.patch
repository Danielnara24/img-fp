+        }
     }
     v
 }
 
+/// SCAFFOLD(v67): the pixel check's blocks on a grid of 96 samples a side, 12 blocks each way.
+fn fine_check(ta: &Thumb, tb: &Thumb, m: &Affine, aw: f32, ah: f32, bw: f32, bh: f32, invert: bool) -> (f32, f32) {
+    #[allow(non_snake_case)]
+    let G: usize = std::env::var("IMGFP_FINE").ok().and_then(|v| v.parse().ok()).unwrap_or(96);
+    const B: usize = 8;
+    const P: usize = 24;
+    let (mut x0, mut y0, mut x1, mut y1) = (f32::MAX, f32::MAX, f32::MIN, f32::MIN);
+    for iy in 0..P {
+        for ix in 0..P {
+            let (x, y) = ((ix as f32 + 0.5) / P as f32 * aw, (iy as f32 + 0.5) / P as f32 * ah);
+            let (u, v) = apply(m, x, y);
+            if u >= 0.0 && u < bw && v >= 0.0 && v < bh { x0 = x0.min(x); y0 = y0.min(y); x1 = x1.max(x); y1 = y1.max(y); }
+        }
+    }
+    if !(x1 > x0 && y1 > y0) { return (0.0, 0.0); }
+    let step_a = ((x1 - x0) / (G - 1) as f32).max((y1 - y0) / (G - 1) as f32);
+    let lin = linear_scale(m);
+    let (raw_a, raw_b) = ((step_a * ta.scale).max(1e-6), (step_a * lin * tb.scale).max(1e-6));
+    let (fa, fb) = (raw_a * (1.0 / raw_b).max(1.0), raw_b * (1.0 / raw_a).max(1.0));
+    let (mut pa, mut pb) = (Pyramid::default(), Pyramid::default());
+    let (la, lb) = (ta.lod(fa, &mut pa), tb.lod(fb, &mut pb));
+    let (sa, sb) = ((ta.w as f32 / aw, ta.h as f32 / ah), (tb.w as f32 / bw, tb.h as f32 / bh));
+    let mut va = vec![0f32; G * G]; let mut vb = vec![0f32; G * G]; let mut ok = vec![false; G * G];
+    for iy in 0..G {
+        for ix in 0..G {
+            let (x, y) = (x0 + (x1 - x0) * ix as f32 / (G - 1) as f32, y0 + (y1 - y0) * iy as f32 / (G - 1) as f32);
+            let (u, v) = apply(m, x, y);
+            if u < 0.0 || u >= bw || v < 0.0 || v >= bh { continue; }
+            let s = la.at((x + 0.5) * sa.0, (y + 0.5) * sa.1);
+            va[iy * G + ix] = if invert { 255.0 - s } else { s };
+            vb[iy * G + ix] = lb.at((u + 0.5) * sb.0, (v + 0.5) * sb.1);
+            ok[iy * G + ix] = true;
+        }
+    }
+    let (mut agree, mut total, mut worst) = (0f32, 0u32, f32::INFINITY);
+    for by in (0..G).step_by(B) {
+        for bx in (0..G).step_by(B) {
+            let (mut n, mut s1, mut s2, mut s11, mut s22, mut s12) = (0usize, 0f64, 0f64, 0f64, 0f64, 0f64);
+            for y in by..by + B { for x in bx..bx + B {
+                let k = y * G + x;
+                if !ok[k] { continue; }
+                n += 1;
+                let (p, q) = (va[k] as f64, vb[k] as f64);
+                s1 += p; s2 += q; s11 += p * p; s22 += q * q; s12 += p * q;
+            } }
+            if n < B * B { continue; }
+            let nf = n as f64;
+            let (v1, v2) = (s11 - s1 * s1 / nf, s22 - s2 * s2 / nf);
+            let flat = 4.0 * 4.0 * nf;
+            if v1 < flat && v2 < flat { continue; }
+            let cov = s12 - s1 * s2 / nf;
+            let r = if v1 < flat || v2 < flat { (2.0 * cov.abs() / (v1 + v2)) as f32 } else { (cov / (v1 * v2).sqrt()).abs() as f32 };
+            total += 1; agree += r; worst = worst.min(r);
+        }
+    }
+    if total == 0 { (0.0, 0.0) } else { (agree / total as f32, worst) }
+}
