+//! Scaffolding (session v56): seeding a verdict's correspondences without the
+//! scan's vocabulary. Not shipped.
+//!
+//! `PROBE_PAIRS=pairs.tsv PROBE_OUT=out.tsv PROBE_MODE=brute|sign:k,l|pstable:k,l,w \
+//!  cargo test --release --lib -- --ignored --nocapture probe_pairs`
+//! Each input line: `kind<TAB>a<TAB>b`. Output: the input, the candidate count,
+//! then n_match n_in ov_a ov_b blk blk_min framed centred.
+
+use crate::analysis::{analyse_plain, Item, Planes};
+use crate::index::WordList;
+use crate::sift::{self, Features, Variant};
+use crate::verify;
+use crate::FEATURES;
+use rayon::prelude::*;
+use std::collections::HashMap;
+use std::io::Write;
+use std::path::Path;
+
+fn line(v: &verify::Verdict) -> String {
+    format!(
+        "{}\t{}\t{:.3}\t{:.3}\t{:.3}\t{:.3}\t{}\t{}",
+        v.n_match, v.n_in, v.ov_a, v.ov_b, v.blk, v.blk_min, v.framed as u8, v.centred as u8
+    )
+}
+
+fn all_pairs(na: usize, nb: usize) -> Vec<(u32, u32)> {
+    let mut c = Vec::with_capacity(na * nb);
+    for i in 0..na as u32 {
+        for j in 0..nb as u32 {
+            c.push((i, j));
+        }
+    }
+    c
+}
+
+struct Rng(u64);
+impl Rng {
+    fn unif(&mut self) -> f64 {
+        let s = &mut self.0;
+        *s ^= *s << 13;
+        *s ^= *s >> 7;
+        *s ^= *s << 17;
+        (*s >> 11) as f64 / (1u64 << 53) as f64
+    }
+    fn gauss(&mut self) -> f32 {
+        let (u1, u2) = (self.unif().max(1e-12), self.unif());
+        ((-2.0 * u1.ln()).sqrt() * (2.0 * std::f64::consts::PI * u2).cos()) as f32
+    }
+}
+
+pub(crate) enum Mode {
+    Brute,
+    /// Sign of random hyperplanes through each descriptor's own mean: `l` tables of `k` bits.
+    Sign(usize, usize, Vec<f32>),
+    /// Integer: random +-1 hyperplanes through the descriptor's mean.
+    Rsign(usize, usize, Vec<i32>),
+    /// p-stable: `l` tables of `k` projections, bucket width `w`.
+    Pstable(usize, usize, f32, Vec<f32>, Vec<f32>),
+}
+
+impl Mode {
+    fn parse(s: &str) -> Mode {
+        let mut r = Rng(0x2545_f491_4f6c_dd1d);
+        if s == "brute" {
+            return Mode::Brute;
+        }
+        let (kind, args) = s.split_once(':').unwrap();
+        let x: Vec<f32> = args.split(',').map(|v| v.parse().unwrap()).collect();
+        let (k, l) = (x[0] as usize, x[1] as usize);
+        let proj: Vec<f32> = (0..k * l * 128).map(|_| r.gauss()).collect();
+        match kind {
+            "sign" => Mode::Sign(k, l, proj),
+            "rsign" => Mode::Rsign(k, l, proj.iter().map(|&x| if x > 0.0 { 1 } else { -1 }).collect()),
+            "pstable" => {
+                let w = x[2];
+                let off = (0..k * l).map(|_| r.unif() as f32 * w).collect();
+                Mode::Pstable(k, l, w, proj, off)
+            }
+            _ => panic!("mode"),
+        }
+    }
+
+    /// A keypoint's entries: one per table, `(table << 16 | key) ` in 21 bits.
+    fn words(&self, f: &Features) -> WordList {
+        let mut e = Vec::new();
+        for i in 0..f.len() {
+            let d = f.d(i);
+            match self {
+                Mode::Sign(k, l, proj) => {
+                    let mean = d.iter().map(|&v| v as f32).sum::<f32>() / 128.0;
+                    for t in 0..*l {
+                        let mut key = 0u32;
+                        for j in 0..*k {
+                            let r = &proj[(t * k + j) * 128..][..128];
+                            let dot: f32 = r.iter().zip(d).map(|(a, &b)| a * (b as f32 - mean)).sum();
+                            key = key << 1 | (dot > 0.0) as u32;
+                        }
+                        let key = if *k > 16 { (key ^ key >> 16) & 0xffff } else { key };
+                        e.push(((t as u32) << 16 | key, i as u32));
+                    }
+                }
+                Mode::Rsign(k, l, proj) => {
+                    let sum: i32 = d.iter().map(|&v| v as i32).sum();
+                    for t in 0..*l {
+                        let mut key = 0u32;
+                        for j in 0..*k {
+                            let r = &proj[(t * k + j) * 128..][..128];
+                            let dot: i32 = r.iter().zip(d).map(|(a, &b)| a * b as i32).sum();
+                            let rs: i32 = r.iter().sum();
+                            key = key << 1 | (dot * 128 > sum * rs) as u32;
+                        }
+                        e.push(((t as u32) << 16 | key, i as u32));
+                    }
+                }
+                Mode::Pstable(k, l, w, proj, off) => {
+                    for t in 0..*l {
+                        let mut h = 0xcbf2_9ce4_8422_2325u64 ^ t as u64;
+                        for j in 0..*k {
+                            let r = &proj[(t * k + j) * 128..][..128];
+                            let dot: f32 = r.iter().zip(d).map(|(a, &b)| a * b as f32).sum();
+                            let q = ((dot + off[t * k + j]) / w).floor() as i64;
+                            h = (h ^ q as u64).wrapping_mul(0x100_0000_01b3);
+                        }
+                        e.push(((t as u32) << 16 | ((h >> 30) as u32 & 0xffff), i as u32));
+                    }
+                }
+                Mode::Brute => unreachable!(),
+            }
+        }
+        e.sort_unstable();
+        e.dedup();
+        WordList::from_sorted(&e)
+    }
+}
+
+#[test]
+#[ignore]
+fn probe_pairs() {
+    let input = std::fs::read_to_string(std::env::var("PROBE_PAIRS").unwrap()).unwrap();
+    let rows: Vec<Vec<String>> = input.lines().filter(|l| !l.is_empty()).map(|l| l.split('\t').map(String::from).collect()).collect();
+    let mut files: Vec<String> = rows.iter().flat_map(|r| [r[1].clone(), r[2].clone()]).collect();
+    files.sort();
+    files.dedup();
+    let sp = sift::Params { max_features: FEATURES, ..Default::default() };
+    let planes = Planes::default();
+    let mode = Mode::parse(&std::env::var("PROBE_MODE").unwrap_or("brute".into()));
+    let t0 = std::time::Instant::now();
+    let items: HashMap<String, Item> = files.par_iter().map(|f| (f.clone(), analyse_plain(Path::new(f), 512, &sp, None, &planes).0)).collect();
+    eprintln!("analysed {} in {:?}", items.len(), t0.elapsed());
+    let t0 = std::time::Instant::now();
+    let words: HashMap<&String, WordList> = match mode {
+        Mode::Brute => HashMap::new(),
+        _ => items.par_iter().map(|(k, it)| (k, mode.words(&it.feats))).collect(),
+    };
+    eprintln!("hashed in {:?}", t0.elapsed());
+    let t0 = std::time::Instant::now();
+    let out: Vec<String> = rows
+        .par_iter()
+        .map(|r| {
+            let (a, b) = (&items[&r[1]], &items[&r[2]]);
+            let p = verify::Pair { fa: &a.feats, fb: &b.feats, ta: &a.thumb, tb: &b.thumb };
+            let cands = match mode {
+                Mode::Brute => all_pairs(a.feats.len(), b.feats.len()),
+                _ => {
+                    let mut c = Vec::new();
+                    crate::index::shared(&words[&r[1]], &words[&r[2]], &mut c, usize::MAX);
+                    c.sort_unstable();
+                    c.dedup();
+                    c
+                }
+            };
+            let mut mt = Vec::new();
+            let v = verify::verify(&p, &cands, Variant::SAME, (3, 0.2), &mut mt, &mut verify::Scratch::default());
+            format!("{}\t{}\t{}\t{}\t{}", r[0], r[1], r[2], cands.len(), line(&v))
+        })
+        .collect();
+    eprintln!("verified in {:?}", t0.elapsed());
+    let mut f = std::fs::File::create(std::env::var("PROBE_OUT").unwrap()).unwrap();
+    for l in out {
+        writeln!(f, "{l}").unwrap();
+    }
+}
