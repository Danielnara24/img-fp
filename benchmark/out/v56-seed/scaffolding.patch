+/// Inliers counted one to one: the most pairs of distinct source positions
+/// and distinct target positions the inliers can match up (a maximum
+/// matching). A transform that shrinks one picture into a spot of the other
+/// carries many of its keypoints within the tolerance of the same few there.
+fn matched_inliers(a: &Features, b: &Features, pairs: &[(u32, u32)], mask: &[bool]) -> u32 {
+    let pos = |k: &crate::sift::Keypoint| ((k.x * 2.0) as i32, (k.y * 2.0) as i32);
+    let mut edges: Vec<((i32, i32), (i32, i32))> =
+        pairs.iter().zip(mask).filter(|&(_, &m)| m).map(|(&(i, j), _)| (pos(&a.kps[i as usize]), pos(&b.kps[j as usize]))).collect();
+    edges.sort_unstable();
+    edges.dedup();
+    let mut an: Vec<(i32, i32)> = edges.iter().map(|e| e.0).collect();
+    an.dedup();
+    let mut bn: Vec<(i32, i32)> = edges.iter().map(|e| e.1).collect();
+    bn.sort_unstable();
+    bn.dedup();
+    let mut adj: Vec<Vec<usize>> = vec![Vec::new(); an.len()];
+    for e in &edges {
+        let ia = an.binary_search(&e.0).unwrap();
+        adj[ia].push(bn.binary_search(&e.1).unwrap());
+    }
+    // Kuhn's augmenting paths: a few hundred nodes at most.
+    let mut owner = vec![usize::MAX; bn.len()];
+    fn augment(u: usize, adj: &[Vec<usize>], seen: &mut [bool], owner: &mut [usize]) -> bool {
+        for &w in &adj[u] {
+            if !seen[w] {
+                seen[w] = true;
+                if owner[w] == usize::MAX || augment(owner[w], adj, seen, owner) {
+                    owner[w] = u;
+                    return true;
+                }
+            }
+        }
+        false
+    }
+    let mut n = 0;
+    let mut seen = vec![false; bn.len()];
+    for u in 0..an.len() {
+        seen.iter_mut().for_each(|s| *s = false);
+        n += augment(u, &adj, &mut seen, &mut owner) as u32;
+    }
+    n
+}
