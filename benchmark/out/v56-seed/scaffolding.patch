+            let (a, b, c, d) = (m[0], m[1], m[3], m[4]);
+            let pp = (a * a + b * b + c * c + d * d) / 2.0;
+            let qq = (pp * pp - (a * d - b * c).powi(2)).max(0.0).sqrt();
+            let (hi, lo) = ((pp + qq).sqrt(), (pp - qq).max(0.0).sqrt());
+            let o: Vec<String> = offs.iter().map(|x| format!("{x:.3}")).collect();
+            Some(format!("{}\t{}\t{}\t{on}\t{}\t{:.4}\t{:.4}\t{:.4}\t{:.3}\t{:.3}\t{:.3}\t{}", r[0], r[1], r[2], v.n_in, v.scale, lo, hi, v.ov_a, v.ov_b, v.blk, o.join(",")))
+        })
+        .collect();
+    let mut f = std::fs::File::create(std::env::var("PROBE_OUT").unwrap()).unwrap();
+    for l in out {
+        writeln!(f, "{l}").unwrap();
+    }
