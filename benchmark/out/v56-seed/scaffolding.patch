+/// Per-bit agreement of the +-1 sign hash against descriptor distance: over the
+/// matches of true pairs' verdicts (by distance band) and over random keypoints of
+/// unrelated pairs.
+#[test]
+#[ignore]
+fn probe_bits() {
+    let input = std::fs::read_to_string(std::env::var("PROBE_PAIRS").unwrap()).unwrap();
+    let rows: Vec<Vec<String>> = input.lines().filter(|l| !l.is_empty()).map(|l| l.split('\t').map(String::from).collect()).collect();
+    let mut files: Vec<String> = rows.iter().flat_map(|r| [r[1].clone(), r[2].clone()]).collect();
+    files.sort();
+    files.dedup();
+    let sp = sift::Params { max_features: FEATURES, ..Default::default() };
+    let planes = Planes::default();
+    let items: HashMap<String, Item> = files.par_iter().map(|f| (f.clone(), analyse_plain(Path::new(f), 512, &sp, None, &planes).0)).collect();
+    let Mode::Rsign(_, _, proj) = Mode::parse("rsign:16,16") else { panic!() };
+    let bits = |d: &[u8]| -> Vec<bool> {
+        let sum: i32 = d.iter().map(|&v| v as i32).sum();
+        (0..256).map(|j| { let r = &proj[j * 128..][..128]; let dot: i32 = r.iter().zip(d).map(|(a, &b)| a * b as i32).sum(); let rs: i32 = r.iter().sum(); dot * 128 > sum * rs }).collect()
+    };
+    let agree = |a: &[u8], b: &[u8]| { let (x, y) = (bits(a), bits(b)); x.iter().zip(&y).filter(|(p, q)| p == q).count() as f64 / 256.0 };
+    let mut bands = vec![(0usize, 0f64); 12];
+    let mut un = (0usize, 0f64);
+    let mut ud = Vec::new();
+    let mut rng = Rng(7);
+    for r in &rows {
+        let (a, b) = (&items[&r[1]], &items[&r[2]]);
+        if a.feats.len() == 0 || b.feats.len() == 0 { continue }
+        if r[0].starts_with("true") {
+            let p = verify::Pair { fa: &a.feats, fb: &b.feats, ta: &a.thumb, tb: &b.thumb };
+            let mut mt = Vec::new();
+            let v = verify::verify(&p, &all_pairs(a.feats.len(), b.feats.len()), Variant::SAME, (3, 0.2), &mut mt, &mut verify::Scratch::default());
+            if v.n_in < 10 { continue }
