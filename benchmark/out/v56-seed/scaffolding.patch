+//! Where a verdict's correspondences are first looked for: a hash of each
+//! descriptor that depends on nothing but the descriptor.
+//!
+//! A verdict seeds its transform from correspondences, and looked for only
+//! between keypoints sharing a vocabulary word they depended on the
+//! vocabulary, so on everything else the run had scanned: a vocabulary
+//! trained on ninety copies of each picture is finest around those pictures'
+//! descriptors, and a sibling photograph's correspondences fell into other
+//! words (`benchmark/out/v45-k`). Guided matching (`verify::guided`) made the
+//! verdict's correspondences independent once a transform is seeded; this
+//! makes the seeding so. Each keypoint is hashed into `TABLES` tables of
+//! `BITS` bits, each bit the side of a fixed random hyperplane through the
+//! descriptor's own mean (signs of +-1 weights, so integer and exact on every
+//! build); two keypoints sharing a table's bucket are a candidate pair, and
+//! `verify::correspond` keeps each A keypoint's nearest as before. The
+//! hyperplanes are drawn once from a constant seed: no picture, no training.
+
+use crate::sift::{Features, DESC_LEN};
+use std::sync::OnceLock;
+
+/// Bits a table. Scaffolding: `IMGFP_SEED=bits,tables`.
+pub(crate) fn params() -> Option<(usize, usize)> {
+    static P: OnceLock<Option<(usize, usize)>> = OnceLock::new();
+    *P.get_or_init(|| {
+        let v = std::env::var("IMGFP_SEED").ok()?;
+        let (k, l) = v.split_once(',')?;
+        let (k, l) = (k.parse().ok()?, l.parse().ok()?);
+        assert!((1..=16).contains(&k) && l >= 1 && k * l <= 96);
+        Some((k, l))
+    })
+}
+
+/// `bits * tables` rows of `DESC_LEN` signs, and each row's sum.
+struct Planes {
+    k: usize,
+    l: usize,
+    w: Vec<i8>,
+    sum: Vec<i32>,
+}
+
+fn planes(k: usize, l: usize) -> &'static Planes {
+    static P: OnceLock<Planes> = OnceLock::new();
+    let p = P.get_or_init(|| {
+        let mut s = 0x2545_f491_4f6c_dd1du64;
+        let w: Vec<i8> = (0..16 * 16 * DESC_LEN)
+            .map(|_| {
+                s ^= s << 13;
+                s ^= s >> 7;
+                s ^= s << 17;
+                if s >> 63 == 1 { 1 } else { -1 }
+            })
+            .collect();
+        let sum = w.chunks(DESC_LEN).map(|r| r.iter().map(|&x| x as i32).sum()).collect();
+        Planes { k, l, w, sum }
+    });
+    assert!(p.k == k && p.l == l);
+    p
+}
+
+/// A keypoint's code: bit `t * k + j` is table `t`'s `j`th sign.
+pub(crate) type Code = [u32; 3];
+
+/// Every keypoint's code.
+pub(crate) fn codes(f: &Features, (k, l): (usize, usize)) -> Vec<Code> {
+    let p = planes(k, l);
+    (0..f.len())
+        .map(|i| {
+            let d: &[u8; DESC_LEN] = f.d(i).try_into().unwrap();
+            let total: i32 = d.iter().map(|&v| v as i32).sum();
+            let mut c = [0u32; 3];
+            for r in 0..k * l {
+                let row: &[i8; DESC_LEN] = p.w[r * DESC_LEN..(r + 1) * DESC_LEN].try_into().unwrap();
+                if dot(row, d) * DESC_LEN as i32 > total * p.sum[r] {
+                    c[r / 32] |= 1 << (r % 32);
+                }
+            }
+            c
+        })
+        .collect()
+}
+
+#[inline(always)]
+fn dot(r: &[i8; DESC_LEN], d: &[u8; DESC_LEN]) -> i32 {
+    let mut s = 0i32;
+    for x in 0..DESC_LEN {
+        s += r[x] as i32 * d[x] as i32;
+    }
+    s
+}
+
+/// Table `t`'s bucket of code `c`, numbered across tables.
+#[inline(always)]
+fn bucket(c: &Code, t: usize, k: usize) -> usize {
+    let at = t * k;
+    let both = (c[at / 32] as u64) | (c.get(at / 32 + 1).copied().unwrap_or(0) as u64) << 32;
+    (t << k) | ((both >> (at % 32)) as usize & ((1 << k) - 1))
+}
+
+#[inline(always)]
+fn apart(a: &Code, b: &Code) -> u32 {
+    (a[0] ^ b[0]).count_ones() + (a[1] ^ b[1]).count_ones() + (a[2] ^ b[2]).count_ones()
+}
+
+/// The most bits two codes sharing a bucket may differ in for their keypoints
+/// to be compared at all: the 99th percentile of the other tables' `k (l - 1)`
+/// bits a correspondence at `verify::GUIDE_D2`'s distance (320) differs in,
+/// each agreeing with probability 0.752 (measured over true pairs' matches at
+/// 300-350; unrelated keypoints agree on 0.549). At 14 x 5, 22 of 56: 99.5%
+/// of such correspondences and 23% of coincidental collisions.
+/// `IMGFP_SEED_H` overrides it (scaffolding).
+fn most_apart() -> u32 {
+    static H: OnceLock<u32> = OnceLock::new();
+    *H.get_or_init(|| {
+        if let Some(h) = std::env::var("IMGFP_SEED_H").ok().and_then(|v| v.parse().ok()) {
+            return h;
+        }
+        let (k, l) = params().unwrap();
+        let n = (k * (l - 1)) as i32;
+        let q = 1.0 - 0.752f64;
+        let mut cum = 0.0;
+        let mut c = 1.0f64; // C(n, h)
+        for h in 0..=n {
+            if h > 0 {
+                c = c * (n - h + 1) as f64 / h as f64;
+            }
+            cum += c * q.powi(h) * (1.0 - q).powi(n - h);
+            if cum >= 0.99 {
+                return h as u32;
+            }
+        }
+        n as u32
+    })
+}
+
+/// One asker's codes by bucket, built once and read for each of its
+/// candidates: `head[w]` is one past the last entry put in bucket `w` (0 for
+/// none), `next[e]` the one before it. Built and cleared in its entries'
+/// steps, not the table's: consecutive pairs often have different askers.
+#[derive(Default)]
+pub(crate) struct Asker {
+    pub(crate) key: Option<(usize, u8)>,
+    head: Vec<u16>,
+    next: Vec<u16>,
+    kp: Vec<u16>,
+    used: Vec<u32>,
+    /// Which buckets hold anything, a bit each: most lookups end here, in L1.
+    occupied: Vec<u64>,
+    best: Vec<(u32, u32)>,
+}
+
+impl Asker {
+    pub(crate) fn build(&mut self, key: (usize, u8), codes: &[Code], (k, l): (usize, usize)) {
+        self.key = Some(key);
+        if self.head.len() != l << k {
+            self.head.clear();
+            self.head.resize(l << k, 0);
+            self.occupied.clear();
+            self.occupied.resize(((l << k) + 63) / 64, 0);
+        }
+        for &w in &self.used {
+            self.head[w as usize] = 0;
+            self.occupied[w as usize / 64] = 0;
+        }
+        self.used.clear();
+        self.next.clear();
+        self.kp.clear();
+        for (i, c) in codes.iter().enumerate() {
+            for t in 0..l {
+                let w = bucket(c, t, k);
+                if self.head[w] == 0 {
+                    self.used.push(w as u32);
+                    self.occupied[w / 64] |= 1 << (w % 64);
+                }
+                self.next.push(self.head[w]);
+                self.kp.push(i as u16);
+                self.head[w] = self.kp.len() as u16;
+            }
+        }
+    }
+
+    /// Each of `a`'s keypoints' nearest among `b`'s sharing a bucket with it
+    /// and within `most_apart` bits, within `bound` (squared), in keypoint
+    /// order; ties to the lower B keypoint.
+    pub(crate) fn nearest(&mut self, a: &Features, ca: &[Code], b: &Features, cb: &[Code], (k, l): (usize, usize), bound: u32, out: &mut Vec<(u32, u32)>) {
+        let h = most_apart();
+        let (mut nv, mut np, mut nd) = (0u64, 0u64, 0u64);
+        self.best.clear();
+        self.best.resize(a.len(), (u32::MAX, u32::MAX));
+        for (tj, c) in cb.iter().enumerate() {
+            for t in 0..l {
+                let w = bucket(c, t, k);
+                if self.occupied[w / 64] >> (w % 64) & 1 == 0 {
+                    continue;
+                }
+                let mut e = self.head[w];
+                while e != 0 {
+                    let qa = self.kp[e as usize - 1];
+                    e = self.next[e as usize - 1];
+                    nv += 1;
+                    if apart(&ca[qa as usize], c) > h {
+                        continue;
+                    }
+                    np += 1;
+                    let d = crate::index::dist2(a.d(qa as usize).try_into().unwrap(), b.d(tj));
+                    let best = &mut self.best[qa as usize];
+                    if d < best.0 {
+                        *best = (d, tj as u32);
+                    }
+                }
+            }
+        }
+        STATS[0].fetch_add(1, Relaxed);
+        STATS[1].fetch_add(nv, Relaxed);
+        STATS[2].fetch_add(np, Relaxed);
+        STATS[3].fetch_add(a.len() as u64 * l as u64, Relaxed);
+        out.clear();
+        for (qa, &(d, tj)) in self.best.iter().enumerate() {
+            nd += (d <= bound) as u64;
+            if d <= bound {
+                out.push((qa as u32, tj));
+            }
+        }
+        STATS[4].fetch_add(nd, Relaxed);
+    }
+}
+
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+/// Scaffolding: pairs, chain entries visited, past the code bound, A entries, matches.
+pub(crate) static STATS: [AtomicU64; 5] = [const { AtomicU64::new(0) }; 5];
+pub(crate) fn stats() -> String {
+    let v: Vec<u64> = STATS.iter().map(|x| x.load(Relaxed)).collect();
+    let p = v[0].max(1) as f64;
+    format!("seed stats: pairs {} visited {:.0} passed {:.0} a-entries {:.0} matches {:.0} (per pair)", v[0], v[1] as f64 / p, v[2] as f64 / p, v[3] as f64 / p, v[4] as f64 / p)
+}
