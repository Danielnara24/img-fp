+/// The median over the inliers of log2(B's keypoint size / (A's keypoint size
+/// times the transform's scale)): about 0 when the points are the same
+/// features, octaves off when a picture shrunk into a spot of the other
+/// gathers fine keypoints onto coarse ones.
+fn median_size_offset(a: &Features, b: &Features, m: &Affine, pairs: &[(u32, u32)], mask: &[bool]) -> f32 {
+    let s = det(m).abs().sqrt().max(1e-12);
+    let mut o: Vec<f32> = pairs
+        .iter()
+        .zip(mask)
+        .filter(|&(_, &k)| k)
+        .map(|(&(i, j), _)| (b.kps[j as usize].sigma / (a.kps[i as usize].sigma.max(1e-6) * s)).log2())
+        .collect();
+    if o.is_empty() {
+        return 0.0;
+    }
+    let mid = o.len() / 2;
+    let (_, x, _) = o.select_nth_unstable_by(mid, |p, q| p.total_cmp(q));
+    *x
+}
