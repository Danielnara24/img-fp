+
+/// Keypoint sizes against the transform: for each `kind<TAB>a<TAB>b` line, the
+/// best verdict as it is (both orders, brute force), then each inlier's
+/// log2(sigma_b / (sigma_a * s)), s the transform's sqrt|det|.
+/// Output: kind a b order n_in scale axis_lo axis_hi ov_a ov_b blk then the offsets.
+#[test]
+#[ignore]
+fn probe_sizes() {
+    let input = std::fs::read_to_string(std::env::var("PROBE_PAIRS").unwrap()).unwrap();
+    let rows: Vec<Vec<String>> = input.lines().filter(|l| !l.is_empty()).map(|l| l.split('\t').map(String::from).collect()).collect();
+    let mut files: Vec<String> = rows.iter().flat_map(|r| [r[1].clone(), r[2].clone()]).collect();
+    files.sort();
+    files.dedup();
+    let sp = sift::Params { max_features: FEATURES, ..Default::default() };
+    let planes = Planes::default();
+    let items: HashMap<String, Item> = files.par_iter().map(|f| (f.clone(), analyse_plain(Path::new(f), 512, &sp, None, &planes).0)).collect();
+    let out: Vec<String> = rows
+        .par_iter()
+        .filter_map(|r| {
+            let mut best: Option<(verify::Verdict, &str, Vec<f32>)> = None;
+            for (on, q, t) in [("ab", &items[&r[1]], &items[&r[2]]), ("ba", &items[&r[2]], &items[&r[1]])] {
+                if q.feats.len() == 0 || t.feats.len() == 0 {
+                    continue;
+                }
+                let p = verify::Pair { fa: &q.feats, fb: &t.feats, ta: &q.thumb, tb: &t.thumb };
+                let mut mt = Vec::new();
+                let v = verify::verify(&p, &all_pairs(q.feats.len(), t.feats.len()), Variant::SAME, (10, 0.85), &mut mt, &mut verify::Scratch::default());
+                if v.n_in < 10 || v.ov_a.max(v.ov_b) < 0.85 {
+                    continue;
+                }
+                if best.as_ref().is_some_and(|b| b.0.n_in >= v.n_in) {
+                    continue;
+                }
+                let m = v.m;
+                let s = (m[0] * m[4] - m[1] * m[3]).abs().sqrt();
+                let offs = mt.iter().map(|&(i, j)| (t.feats.kps[j as usize].sigma / (q.feats.kps[i as usize].sigma * s)).log2()).collect();
+                best = Some((v, on, offs));
+            }
+            let (v, on, offs) = best?;
