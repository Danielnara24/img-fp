+
+/// Why a verdict passes: for each `a<TAB>b` line, every order and variant by
+/// brute force, and for each verdict past the default bars its transform and
+/// inliers (positions, keypoint scales and angles).
+/// `PROBE_PAIRS=... PROBE_OUT=dir cargo test --release --lib -- --ignored --nocapture probe_why`
+#[test]
+#[ignore]
+fn probe_why() {
+    let input = std::fs::read_to_string(std::env::var("PROBE_PAIRS").unwrap()).unwrap();
+    let out = std::env::var("PROBE_OUT").unwrap();
+    let sp = sift::Params { max_features: FEATURES, ..Default::default() };
