+/// SCAFFOLDING (v61): a dumped verdict's block map, as text.
+fn blocks_of(r: &Dumped) -> (String, String) {
+    let v = &r.e.v;
+    if v.n_in < 10 || v.blk < 0.6 {
+        return (String::new(), String::new());
+    }
+    let (a, b) = (&r.items[r.e.a()], &r.items[r.e.b()]);
+    let map = verify::block_map(&a.thumb, &b.thumb, &v.m, a.feats.w as f32, a.feats.h as f32, b.feats.w as f32, b.feats.h as f32, v.variant.invert);
+    let vals: Vec<String> = map.iter().map(|(x, _)| if x.is_nan() { String::new() } else { format!("{x:.3}") }).collect();
+    (vals.join(";"), map.iter().map(|(_, k)| *k as char).collect())
+}
