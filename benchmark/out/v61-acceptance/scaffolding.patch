+/// SCAFFOLDING (v61): the pixel check's blocks for one transform.
+pub fn block_map(ta: &Thumb, tb: &Thumb, m: &Affine, aw: f32, ah: f32, bw: f32, bh: f32, invert: bool) -> Vec<(f32, u8)> {
+    const NB: usize = (GRID / BLOCK) * (GRID / BLOCK);
+    BLOCK_MAP.with(|c| *c.borrow_mut() = Some(vec![(f32::NAN, b'p'); NB]));
