+//! Where a verdict's first correspondences come from: words of a vocabulary
+//! trained once, on photographs no scan holds, so that which keypoints of two
+//! pictures are compared depends on the two pictures alone.
+//!
+//! **Why.** A verdict is seeded by correspondences, and they used to be the
+//! keypoint pairs sharing a word of the run's own vocabulary, which is
+//! trained on whatever is scanned. A vocabulary trained on ninety copies of
+//! a photograph is finest around that photograph's descriptors, so a near
+//! sibling's correspondences fell into other words; the same pair of files
+//! was judged one way in a folder of sixty and another in a folder of five
+//! thousand (`benchmark/out/v45-k`). Guided matching (`verify::guided`) made
+//! the verdict independent of the vocabulary once a transform was seeded;
+//! this makes the seeding so. The run's vocabulary now only proposes which
+//! files to compare (`retrieve`).
+//!
+//! **What.** The tree (`fixed.vocab.zst`, 65,536 leaves of 16 x 16 x 16 x
+//! 16) was trained by `tests::train_fixed_vocabulary` on 10,000 DISC21
+//! reference photographs (R000000-R009999), never part of a benchmark
+//! corpus. A descriptor is quantised in a canonical orientation: of its four
+//! mirror / invert orientations (`Variant`, a group in which composing two is
+//! the xor of their numbers) the one reading highest along a fixed direction
+//! (`key`), so a file's mirrored and inverted words are its own relabelled
+//! (`turned`), and the second look needs no descent at all. Its word is the
+//! leaf and the orientation (`leaf << 2 | g`).
+//!
+//! Each file has two lists (`Words`): `own`, its best orientation's best leaf
+//! a keypoint, and `asks`, the best two leaves under each of its best two
+//! orientations. A pair is matched from the asker's `asks` against the
+//! candidate's `own` (`correspond`): soft on one side, as a query is against
+//! a database, so a correspondence near a leaf's or an orientation's border
+//! is still met, at about half the pairs symmetric softness costs. Each of
+//! the asker's keypoints keeps its nearest such candidate keypoint, within
+//! `verify::GUIDE_D2` and only when that keypoint's nearest is it in turn
+//! (mutual): a correspondence that two coincidences agree on is rarer than
+//! one either gives. Measured in `benchmark/out/v57-fixed`.
+
+use crate::index::{Vocabulary, WordList};
+use crate::sift::{Features, Variant, DESC_LEN};
+use std::sync::OnceLock;
+
+/// The vocabulary, as `tests::train_fixed_vocabulary` wrote it, compressed.
+const VOCABULARY: &[u8] = include_bytes!("fixed.vocab.zst");
+
+/// Leaves the asker's descent keeps in each orientation it asks in.
+fn asker_paths() -> usize { std::env::var("IMGFP_AP").ok().and_then(|v| v.parse().ok()).unwrap_or(3) }
+fn own_paths() -> usize { std::env::var("IMGFP_OP").ok().and_then(|v| v.parse().ok()).unwrap_or(1) }
+
+/// Orientations the asker asks in.
+const ASKER_ORIENTATIONS: usize = 2;
+
+/// The fixed vocabulary.
+pub(crate) fn vocabulary() -> &'static Vocabulary {
+    static V: OnceLock<Vocabulary> = OnceLock::new();
+    V.get_or_init(|| {
+        let raw = zstd::decode_all(VOCABULARY).expect("the fixed vocabulary decompresses");
+        let mut v = Vocabulary::from_bytes(&raw).expect("the fixed vocabulary reads");
+        v.set_paths(asker_paths());
+        v
+    })
+}
+
+/// Words the fixed vocabulary can return: a leaf in each orientation.
+fn n_words() -> usize {
+    vocabulary().n_live_words() * 4
+}
+
+/// The four orientations' permutations, by `mirror | invert << 1`: where
+/// each bin of a descriptor seen so comes from, read off `Features::seen_as`
+/// of a descriptor whose bins are their own numbers. Mirror and invert
+/// commute and are each their own inverse, so composing two is the xor of
+/// their numbers.
+fn perms() -> &'static [[u8; DESC_LEN]; 4] {
+    static P: OnceLock<[[u8; DESC_LEN]; 4]> = OnceLock::new();
+    P.get_or_init(|| {
+        let numbered = Features { w: 1, h: 1, kps: vec![crate::sift::Keypoint::default()].into(), desc: (0..DESC_LEN as u8).collect::<Vec<u8>>().into(), ends: Vec::new() };
+        std::array::from_fn(|g| numbered.seen_as(Variant { mirror: g & 1 != 0, invert: g & 2 != 0 }).d(0).try_into().unwrap())
+    })
+}
+
+/// A fixed direction of signs, from a constant seed: the orientation a
+/// descriptor is quantised in is the one its bins read highest along.
+fn key() -> &'static [i32; DESC_LEN] {
+    static K: OnceLock<[i32; DESC_LEN]> = OnceLock::new();
+    K.get_or_init(|| {
+        let mut s = 0x9e37_79b9_7f4a_7c15u64;
+        std::array::from_fn(|_| {
+            s ^= s << 13;
+            s ^= s >> 7;
+            s ^= s << 17;
+            if s >> 63 == 1 { 1 } else { -1 }
+        })
+    })
+}
+
+/// `d`'s orientations by how high they read along `key`, best first; a tie
+/// goes to the orientation whose bytes are the lesser, which is a property
+/// of the descriptor and not of its labels, so `d` seen turned orders the
+/// same descriptors the same way (`turned`).
+#[inline(always)]
+fn orientations(d: &[u8]) -> [usize; 4] {
+    let (k, p) = (key(), perms());
+    let mut sc = [(0i32, 0usize); 4];
+    for (g, s) in sc.iter_mut().enumerate() {
+        let mut t = 0i32;
+        for i in 0..DESC_LEN {
+            t += k[i] * d[p[g][i] as usize] as i32;
+        }
+        *s = (t, g);
+    }
+    sc.sort_unstable_by(|a, b| b.0.cmp(&a.0).then_with(|| oriented(d, a.1).cmp(&oriented(d, b.1))));
+    sc.map(|x| x.1)
+}
+
+/// `d` in orientation `g`.
+#[inline(always)]
+fn oriented(d: &[u8], g: usize) -> [u8; DESC_LEN] {
+    let p = &perms()[g];
+    std::array::from_fn(|i| d[p[i] as usize])
+}
+
+/// A file's fixed words: what it asks with (`asks`) and what it is asked by
+/// (`own`).
+#[derive(Default)]
+pub(crate) struct Words {
+    pub(crate) asks: WordList,
+    pub(crate) own: WordList,
+}
+
+crate::simd::dispatched! {
+    /// `f`'s fixed words: one descent per orientation asked in.
+    pub(crate) fn words(f: &Features) -> Words => words_any;
+}
+
+#[cfg_attr(dispatch, inline(always))]
+fn words_any(f: &Features) -> Words {
+    let vocab = vocabulary();
+    let mut buf = Vec::with_capacity(asker_paths());
+    let op = own_paths();
+    let mut asks: Vec<(u32, u32)> = Vec::with_capacity(f.len() * asker_paths() * ASKER_ORIENTATIONS);
+    let mut own: Vec<(u32, u32)> = Vec::with_capacity(f.len());
+    for i in 0..f.len() {
+        let d = f.d(i);
+        for (k, &g) in orientations(d)[..ASKER_ORIENTATIONS].iter().enumerate() {
+            vocab.quantise(&oriented(d, g), &mut buf);
+            for (n, &w) in buf.iter().enumerate() {
+                asks.push((w << 2 | g as u32, i as u32));
+                if k == 0 && n < op {
+                    own.push((w << 2 | g as u32, i as u32));
+                }
+            }
+        }
+    }
+    asks.sort_unstable();
+    asks.dedup();
+    own.sort_unstable();
+    own.dedup();
+    Words { asks: WordList::from_sorted(&asks), own: WordList::from_sorted(&own) }
+}
+
+/// The words `w` (made by `words` from some features) of those features seen
+/// as `v`: each word's orientation composed with `v`'s, no descent. Seen as
+/// `v`, a descriptor's orientations read along `key` as its own did, each
+/// composed with `v`, so its canonical form is the same descriptor.
+pub(crate) fn turned(w: &WordList, v: Variant) -> WordList {
+    let x = v.mirror as u32 | (v.invert as u32) << 1;
+    let mut pairs: Vec<(u32, u32)> = (0..w.len()).map(|i| (w.word(i) ^ x, w.kp(i))).collect();
+    pairs.sort_unstable();
+    WordList::from_sorted(&pairs)
+}
+
+/// One asker's words, built once for the run of candidates it is verified
+/// against: its entries in word order, and which words it has as a bit a
+/// word (`has`, small enough to stay in L1 while most of an unrelated
+/// candidate's words are turned away). A candidate's words come in the same
+/// order, so its hits are found by walking the asker's entries forward, never
+/// by a lookup into a table as large as the vocabulary: on a corpus of copies,
+/// where nearly every word hits, a 1 MB table read at random cost twice the
+/// rest of the pass. The bits are set only for the asker's words and cleared
+/// after, never swept whole.
+#[derive(Default)]
+pub(crate) struct Table {
+    key: Option<(usize, u8, usize)>,
+    has: Vec<u64>,
+    words: Vec<u32>,
+    kps: Vec<u32>,
+    best: Vec<(u32, u32)>,
+    best_b: Vec<(u32, u32)>,
+}
+
+impl Table {
+    /// Ready for `asks`, the words of file `i` seen as `v` (`key` tells
+    /// whether it already is).
+    fn ask(&mut self, key: (usize, u8, usize), asks: &WordList) {
+        if self.key == Some(key) {
+            return;
+        }
+        let n = n_words().div_ceil(64);
+        if self.has.len() != n {
+            self.has = vec![0; n];
+        }
+        for &w in &self.words {
+            self.has[w as usize / 64] = 0;
+        }
+        self.words.clear();
+        self.kps.clear();
+        for e in 0..asks.len() {
+            let w = asks.word(e);
+            self.has[w as usize / 64] |= 1 << (w % 64);
+            self.words.push(w);
+            self.kps.push(asks.kp(e));
+        }
+        self.key = Some(key);
+    }
+}
+
+/// The correspondences between file `i` seen as `v` (features `fa`, words
+/// `asks`) and a candidate (`fb`, its `own` words), into `out`: each of A's
+/// keypoints with the nearest of B's that share a word with it (the lower on
+/// a tie), when within `bound` (a squared distance) and when that B keypoint's
+/// nearest among those sharing a word with it is this A keypoint (the lower
+/// on a tie). In A's keypoint order.
+#[allow(clippy::too_many_arguments)]
+pub(crate) fn correspond(table: &mut Table, i: usize, v: Variant, fa: &Features, asks: &WordList, fb: &Features, own: &WordList, bound: u32, out: &mut Vec<(u32, u32)>) {
+    let vb = v.mirror as u8 | (v.invert as u8) << 1;
+    table.ask((i, vb, asks as *const WordList as usize), asks);
+    correspond_in(table, fa, fb, own, bound, out);
+}
+
+crate::simd::dispatched! {
+    fn correspond_in(t: &mut Table, fa: &Features, fb: &Features, own: &WordList, bound: u32, out: &mut Vec<(u32, u32)>) => correspond_in_any;
+}
+
+#[cfg_attr(dispatch, inline(always))]
+fn correspond_in_any(t: &mut Table, fa: &Features, fb: &Features, own: &WordList, bound: u32, out: &mut Vec<(u32, u32)>) {
+    t.best.clear();
+    t.best.resize(fa.len(), (u32::MAX, u32::MAX));
+    t.best_b.clear();
+    t.best_b.resize(fb.len(), (u32::MAX, u32::MAX));
+    // Where the asker's entries of the word last met begin: both lists are
+    // in word order, so it only moves forward.
+    let mut at = 0usize;
+    for e in 0..own.len() {
+        let w = own.word(e);
+        if t.has[w as usize / 64] >> (w % 64) & 1 == 0 {
+            continue;
+        }
+        while t.words[at] < w {
+            at += 1;
+        }
+        let kb = own.kp(e);
+        let db: &[u8; DESC_LEN] = fb.d(kb as usize).try_into().unwrap();
+        let mut x = at;
+        while x < t.words.len() && t.words[x] == w {
+            let ka = t.kps[x];
+            let d = crate::index::dist2(db, fa.d(ka as usize));
+            let a = &mut t.best[ka as usize];
+            if (d, kb) < *a {
+                *a = (d, kb);
+            }
+            let b = &mut t.best_b[kb as usize];
+            if (d, ka) < *b {
+                *b = (d, ka);
+            }
+            x += 1;
+        }
+    }
+    out.clear();
+    for (ka, &(d, kb)) in t.best.iter().enumerate() {
+        if d <= bound && t.best_b[kb as usize].1 == ka as u32 {
+            out.push((ka as u32, kb));
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::sift::Keypoint;
+
+    /// The orientations compose as their numbers' xor, which `turned` relies
+    /// on: mirror and invert commute, and each undoes itself.
+    #[test]
+    fn orientations_compose_as_xor() {
+        let p = perms();
+        for g in 0..4 {
+            for h in 0..4 {
+                let composed: [u8; DESC_LEN] = std::array::from_fn(|i| p[h][p[g][i] as usize]);
+                assert_eq!(composed, p[g ^ h], "{g} then {h}");
+            }
+        }
+    }
+
+    /// Features of `n` random descriptors at random places.
+    fn random_features(n: usize, seed: u64) -> Features {
+        let mut s = seed;
+        let mut rnd = move || {
+            s ^= s << 13;
+            s ^= s >> 7;
+            s ^= s << 17;
+            s
+        };
+        let desc: Vec<u8> = (0..n * DESC_LEN).map(|_| (rnd() % 64) as u8).collect();
+        let kps: Vec<Keypoint> = (0..n).map(|_| Keypoint { x: (rnd() % 500) as f32, y: (rnd() % 400) as f32, sigma: 2.0, angle: (rnd() % 360) as f32, ..Default::default() }).collect();
+        Features { w: 500, h: 400, kps: kps.into(), desc: desc.into(), ends: Vec::new() }
+    }
+
+    /// The vocabulary is the one trained: it reads, and is the size it was.
+    #[test]
+    fn the_fixed_vocabulary_reads() {
+        let v = vocabulary();
+        assert_eq!((v.branching, v.depth), (16, 4));
+        assert!(v.n_live_words() > 60_000, "{} words", v.n_live_words());
+    }
+
+    /// A file's words seen mirrored, inverted or both are its own words with
+    /// the orientation relabelled: what the second look asks with, made
+    /// without a descent, is what a descent would have made.
+    #[test]
+    fn turned_words_are_the_words_of_the_turned_features() {
+        let f = random_features(300, 0x1234_5678_9abc_def1);
+        let w = words(&f);
+        for v in Variant::TURNED {
+            let seen = f.seen_as(v);
+            let direct = words(&seen);
+            let relabelled = turned(&w.asks, v);
+            let same = |a: &WordList, b: &WordList| a.len() == b.len() && (0..a.len()).all(|e| (a.word(e), a.kp(e)) == (b.word(e), b.kp(e)));
+            assert!(same(&direct.asks, &relabelled), "{v:?}");
+        }
+    }
+
+    /// `correspond` is the brute-force answer over the keypoint pairs sharing
+    /// a word: nearest each way, mutual, within the bound.
+    #[test]
+    fn correspond_is_mutual_nearest_among_shared_words() {
+        let fa = random_features(250, 0xdead_beef_0bad_f00d);
+        let mut fb = random_features(250, 0x0123_4567_89ab_cdef);
+        // Some of B is a noisy copy of A, so there is something to find.
+        let mut desc = fb.desc.to_vec();
+        for k in 0..120 {
+            for x in 0..DESC_LEN {
+                desc[k * DESC_LEN + x] = fa.d(k * 2)[x].saturating_add((x % 3) as u8);
+            }
+        }
+        fb.desc = desc.into();
+        let (wa, wb) = (words(&fa), words(&fb));
+        let bound = 320 * 320;
+        let mut got = Vec::new();
+        correspond(&mut Table::default(), 0, Variant::SAME, &fa, &wa.asks, &fb, &wb.own, bound, &mut got);
+        let mut shares = std::collections::HashSet::new();
+        for a in 0..wa.asks.len() {
+            for b in 0..wb.own.len() {
+                if wa.asks.word(a) == wb.own.word(b) {
+                    shares.insert((wa.asks.kp(a), wb.own.kp(b)));
+                }
+            }
+        }
+        let d = |a: u32, b: u32| crate::index::dist2(fb.d(b as usize).try_into().unwrap(), fa.d(a as usize));
+        let best_a = |a: u32| shares.iter().filter(|p| p.0 == a).map(|p| (d(p.0, p.1), p.1)).min();
+        let best_b = |b: u32| shares.iter().filter(|p| p.1 == b).map(|p| (d(p.0, p.1), p.0)).min();
+        let want: Vec<(u32, u32)> = (0..fa.len() as u32)
+            .filter_map(|a| best_a(a).filter(|&(dd, b)| dd <= bound && best_b(b).map(|x| x.1) == Some(a)).map(|(_, b)| (a, b)))
+            .collect();
+        assert!(want.len() >= 60, "the copy is found: {}", want.len());
+        assert_eq!(got, want);
+    }
+
+    /// Trains the fixed vocabulary from scratch (`IMGFP_TRAIN_FROM`, the
+    /// folder of DISC21 reference photographs R000000-R009999) and checks it
+    /// is byte for byte the shipped one; `IMGFP_TRAIN_TO` writes it instead.
+    /// `cargo test --release -- --ignored --nocapture train_fixed_vocabulary`
+    #[test]
+    #[ignore]
+    fn train_fixed_vocabulary() {
+        use crate::analysis::{analyse, Planes};
+        use rayon::prelude::*;
+        let from = std::env::var("IMGFP_TRAIN_FROM").expect("IMGFP_TRAIN_FROM: the DISC21 references");
+        let mut files: Vec<_> = std::fs::read_dir(&from).unwrap().map(|e| e.unwrap().path()).filter(|p| p.extension().is_some_and(|e| e == "jpg")).collect();
+        files.sort();
+        let p = crate::sift::Params { max_features: crate::analysis::FEATURES, ..Default::default() };
+        let planes = Planes::default();
+        let feats: Vec<Features> = files
+            .par_iter()
+            .filter_map(|f| {
+                let (it, _) = analyse(f, 512, 512, &p, None, &planes, false);
+                it.read.ok().then(|| it.feats.as_ref().clone())
+            })
+            .collect();
+        // Every descriptor a picture has, up to its share, in its canonical
+        // orientation: the tree is grown in the space it is asked in.
+        let per = feats.iter().map(|f| f.len()).sum::<usize>() / feats.len().max(1);
+        let canon: Vec<[u8; DESC_LEN]> = feats
+            .iter()
+            .flat_map(|f| (0..f.len().min(per.max(crate::analysis::FEATURES))).map(move |i| f.d(i)))
+            .map(|d| oriented(d, orientations(d)[0]))
+            .collect();
+        let pool: Vec<&[u8; DESC_LEN]> = canon.iter().collect();
+        let vp = crate::index::VocabParams { branching: 16, depth: 4, sample: 1_500_000, iters: 12, max_paths: 3, path_ratio: 1.3, seed: 0x5eed_0f12_ed00_0001 };
+        let v = Vocabulary::build(pool, &vp);
+        let bytes = v.to_bytes();
+        if let Ok(to) = std::env::var("IMGFP_TRAIN_TO") {
+            std::fs::write(to, &bytes).unwrap();
+        } else {
+            assert!(zstd::decode_all(VOCABULARY).unwrap() == bytes, "the shipped vocabulary is what this trains");
+        }
+    }
+}
