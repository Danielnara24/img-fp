+        for k in 0..BLOCK {
+            let av = _mm256_set1_epi32((*a.get_unchecked(k) | KP_MASK) as i32);
+            acc = _mm256_or_si256(acc, _mm256_cmpeq_epi32(av, bv));
+        }
+        _mm256_movemask_epi8(acc) != 0
+    }
