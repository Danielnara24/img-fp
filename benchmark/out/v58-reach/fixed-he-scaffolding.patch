index 0000000..75b17b5
--- /dev/null
+++ b/src/he.rs
@@ -0,0 +1,265 @@
+//! SCAFFOLDING (v58-reach): retrieval by Hamming embedding over the fixed
+//! vocabulary. A file's own fixed words are the postings, each with a 64-bit
+//! signature of its descriptor (the signs of a fixed random projection of the
+//! descriptor in its word's orientation, less the projection of the word's
+//! centre). A query keypoint meets a posting when they share a word and their
+//! signatures differ in at most `h()` bits; each query keypoint counts once
+//! per image, at the word's idf squared, and a score is the share of the
+//! query's mass met (containment, as `index::InvertedFile::query`).
+use crate::fixed;
+use crate::index::WordList;
+use crate::sift::{Features, DESC_LEN};
+use rayon::prelude::*;
+use std::sync::OnceLock;
+
+pub(crate) fn h() -> u32 {
+    static H: OnceLock<u32> = OnceLock::new();
+    *H.get_or_init(|| std::env::var("IMGFP_HE_H").ok().and_then(|v| v.parse().ok()).unwrap_or(24))
+}
+
+pub(crate) fn on() -> bool {
+    std::env::var("IMGFP_HE").is_ok_and(|v| v == "1")
+}
+
+/// Random signs flipping each dimension before the transform.
+fn flips() -> &'static [i32; DESC_LEN] {
+    static F: OnceLock<[i32; DESC_LEN]> = OnceLock::new();
+    F.get_or_init(|| {
+        let mut s = 0x2545_f491_4f6c_dd1du64;
+        std::array::from_fn(|_| {
+            s ^= s << 13;
+            s ^= s >> 7;
+            s ^= s << 17;
+            if s >> 63 == 1 { 1 } else { -1 }
+        })
+    })
+}
+
+/// 64 coefficients of the Walsh-Hadamard transform of `d` with its
+/// dimensions' signs flipped at random: a structured random projection.
+#[inline(always)]
+fn project(d: &[u8]) -> [i32; 64] {
+    let f = flips();
+    let mut x = [0i32; DESC_LEN];
+    for i in 0..DESC_LEN {
+        x[i] = d[i] as i32 * f[i];
+    }
+    let mut h = 1;
+    while h < DESC_LEN {
+        let mut i = 0;
+        while i < DESC_LEN {
+            for j in i..i + h {
+                let (a, b) = (x[j], x[j + h]);
+                x[j] = a + b;
+                x[j + h] = a - b;
+            }
+            i += 2 * h;
+        }
+        h *= 2;
+    }
+    // Coefficient 0 is the sum, nearly constant: skip it.
+    std::array::from_fn(|b| x[b + 1])
+}
+
+/// Each leaf's centre projected.
+fn centres() -> &'static Vec<[i32; 64]> {
+    static C: OnceLock<Vec<[i32; 64]>> = OnceLock::new();
+    C.get_or_init(|| {
+        let v = fixed::vocabulary();
+        (0..v.n_live_words() as u32).into_par_iter().map(|w| project(v.leaf(w))).collect()
+    })
+}
+
+#[inline(always)]
+fn sign(p: &[i32; 64], leaf: u32) -> u64 {
+    let c = &centres()[leaf as usize];
+    let mut s = 0u64;
+    for b in 0..64 {
+        s |= ((p[b] > c[b]) as u64) << b;
+    }
+    s
+}
+
+/// Each entry of `wl` (fixed words `leaf << 2 | g`) with its signature.
+pub(crate) fn signed(f: &Features, wl: &WordList) -> Vec<(u32, u64, u32)> {
+    // Each keypoint projected once per orientation it is quantised in.
+    let mut slot: Vec<[u32; 4]> = vec![[u32::MAX; 4]; f.len()];
+    let mut proj: Vec<[i32; 64]> = Vec::new();
+    let mut out = Vec::with_capacity(wl.len());
+    for e in 0..wl.len() {
+        let (w, kp) = (wl.word(e), wl.kp(e));
+        let g = (w & 3) as usize;
+        let at = &mut slot[kp as usize][g];
+        if *at == u32::MAX {
+            *at = proj.len() as u32;
+            proj.push(project(&fixed::oriented(f.d(kp as usize), g)));
+        }
+        out.push((w, sign(&proj[*at as usize], w >> 2), kp));
+    }
+    out
+}
