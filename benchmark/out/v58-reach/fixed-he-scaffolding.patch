+pub(crate) struct HeIndex {
+    off: Vec<u32>,
+    img: Vec<u32>,
+    sig: Vec<u64>,
+    idf2: Vec<f32>,
+    pub(crate) mass: Vec<f32>,
+}
+
+impl HeIndex {
+    pub(crate) fn build(items: &[crate::analysis::Item], matched: &[bool], words: &[fixed::Words]) -> HeIndex {
+        let nw = fixed::n_words();
+        let own: Vec<Vec<(u32, u64, u32)>> = (0..items.len()).into_par_iter().map(|i| if matched[i] { signed(&items[i].feats, &words[i].own) } else { Vec::new() }).collect();
+        let mut count = vec![0u32; nw + 1];
+        for o in &own {
+            for &(w, ..) in o {
+                count[w as usize + 1] += 1;
+            }
+        }
+        let mut df = vec![0u32; nw];
+        let mut last = vec![u32::MAX; nw];
+        for (i, o) in own.iter().enumerate() {
+            for &(w, ..) in o {
+                if last[w as usize] != i as u32 {
+                    last[w as usize] = i as u32;
+                    df[w as usize] += 1;
+                }
+            }
+        }
+        for w in 0..nw {
+            count[w + 1] += count[w];
+        }
+        let off = count.clone();
+        let total = off[nw] as usize;
+        let mut img = vec![0u32; total];
+        let mut sig = vec![0u64; total];
+        let mut at = count;
+        for (i, o) in own.iter().enumerate() {
+            for &(w, s, _) in o {
+                let k = at[w as usize] as usize;
+                img[k] = i as u32;
+                sig[k] = s;
+                at[w as usize] += 1;
+            }
+        }
+        if std::env::var("IMGFP_HE_STAT").is_ok() {
+            stat(items, &own, &off, &img);
+        }
+        let n = matched.iter().filter(|&&m| m).count().max(1) as f32;
+        let idf2: Vec<f32> = df.iter().map(|&d| if d == 0 { 0.0 } else { let x = (n / d as f32).ln(); x * x }).collect();
+        let mass = own.iter().map(|o| o.iter().map(|&(w, ..)| idf2[w as usize]).sum()).collect();
+        HeIndex { off, img, sig, idf2, mass }
+    }
+
+    pub(crate) fn postings(&self) -> usize {
+        self.img.len()
+    }
+
+    /// Images met by `q` (entries: word, signature, keypoint), scored as
+    /// containment of the query's own mass `qmass`, into `out`.
+    pub(crate) fn query(&self, q: &[(u32, u64, u32)], qmass: f32, exclude: u32, acc: &mut [f32], tag: &mut [u32], touched: &mut Vec<u32>, pass: &mut Vec<u32>, out: &mut Vec<(u32, f32)>) {
+        out.clear();
+        touched.clear();
+        let hh = h();
+        let mut reads = 0u64;
+        let mut hits = 0u64;
+        // Tags run over keypoints; a fresh query starts past any tag used.
+        for &(w, s, kp) in q {
+            let w = w as usize;
+            let (p0, p1) = (self.off[w] as usize, self.off[w + 1] as usize);
+            let idf2 = self.idf2[w];
+            let t = kp + 1;
+            reads += (p1 - p0) as u64;
+            crate::timed!(48, scan(&self.sig[p0..p1], s, hh, pass));
+            hits += pass.len() as u64;
+            for &k in pass.iter() {
+                let o = self.img[p0 + k as usize] as usize;
+                if o as u32 == exclude || tag[o] == t {
+                    continue;
+                }
+                if tag[o] == 0 {
+                    touched.push(o as u32);
+                }
+                tag[o] = t;
+                acc[o] += idf2;
+            }
+        }
+        READS.fetch_add(reads, std::sync::atomic::Ordering::Relaxed);
+        HITS.fetch_add(hits, std::sync::atomic::Ordering::Relaxed);
+        QUERIES.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        let inv = 1.0 / qmass.max(1e-6);
+        for &o in touched.iter() {
+            out.push((o, acc[o as usize] * inv));
+            acc[o as usize] = 0.0;
+            tag[o as usize] = 0;
+        }
+    }
+}
+
+pub(crate) static READS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub(crate) static HITS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub(crate) static QUERIES: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub(crate) fn counts() -> String {
+    use std::sync::atomic::Ordering::Relaxed;
+    format!("he queries {} postings read {} passed {}", QUERIES.load(Relaxed), READS.load(Relaxed), HITS.load(Relaxed))
+}
+
+crate::simd::dispatched! {
+    /// The offsets in `sig` within `hh` bits of `s`, into `out`.
+    fn scan(sig: &[u64], s: u64, hh: u32, out: &mut Vec<u32>) => scan_any;
+}
+
+#[cfg_attr(dispatch, inline(always))]
+fn scan_any(sig: &[u64], s: u64, hh: u32, out: &mut Vec<u32>) {
+    out.clear();
+    out.reserve(sig.len() + 1);
+    let p = out.as_mut_ptr();
+    let mut n = 0usize;
+    for (k, &x) in sig.iter().enumerate() {
+        // SAFETY: n <= k < sig.len() < capacity.
+        unsafe { *p.add(n) = k as u32 };
+        n += ((x ^ s).count_ones() <= hh) as usize;
+    }
+    // SAFETY: the first n were written.
+    unsafe { out.set_len(n) };
+}
+
+/// SCAFFOLDING: Hamming distances of same-word keypoint pairs of different
+/// files, by whether their descriptors lie within `GUIDE_D2`.
+fn stat(items: &[crate::analysis::Item], own: &[Vec<(u32, u64, u32)>], off: &[u32], img: &[u32]) {
+    // Postings' keypoints and signatures, by word, rebuilt here.
+    let nw = off.len() - 1;
+    let mut by: Vec<Vec<(u32, u32, u64)>> = vec![Vec::new(); nw];
+    for (i, o) in own.iter().enumerate() {
+        for &(w, s, kp) in o {
+            by[w as usize].push((i as u32, kp, s));
+        }
+    }
+    let _ = img;
+    let (mut near, mut far) = ([0u64; 65], [0u64; 65]);
+    let mut d2s = [0u64; 65];
+    let mut x = 0x1234_5678u64;
+    for w in (0..nw).step_by(7) {
+        let p = &by[w];
+        if p.len() < 2 { continue; }
+        for _ in 0..p.len().min(2000) {
+            x ^= x << 13; x ^= x >> 7; x ^= x << 17;
+            let a = (x % p.len() as u64) as usize;
+            x ^= x << 13; x ^= x >> 7; x ^= x << 17;
+            let b = (x % p.len() as u64) as usize;
+            if p[a].0 == p[b].0 { continue; }
+            let ga = (w & 3) as usize;
+            let da = fixed::oriented(items[p[a].0 as usize].feats.d(p[a].1 as usize), ga);
+            let db = fixed::oriented(items[p[b].0 as usize].feats.d(p[b].1 as usize), ga);
+            let d2: u32 = (0..DESC_LEN).map(|i| { let t = da[i] as i32 - db[i] as i32; (t * t) as u32 }).sum();
+            let h = (p[a].2 ^ p[b].2).count_ones() as usize;
+            if d2 <= 143 * 143 { near[h] += 1 } else if d2 > crate::verify::GUIDE_D2 { far[h] += 1 }
+            d2s[((d2 as f64).sqrt() / 20.0).min(64.0) as usize] += 1;
+        }
+    }
+    let cum = |v: &[u64; 65]| { let t: u64 = v.iter().sum(); let mut c = 0; (0..65).map(|h| { c += v[h]; format!("{h}:{:.4}", c as f64 / t.max(1) as f64) }).collect::<Vec<_>>().join(" ") };
+    eprintln!("HE_STAT near (n {}) {}", near.iter().sum::<u64>(), cum(&near));
+    eprintln!("HE_STAT far (n {}) {}", far.iter().sum::<u64>(), cum(&far));
+    eprintln!("HE_STAT dist/20 {:?}", d2s);
+}
