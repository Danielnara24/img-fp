+// SCAFFOLDING (v58-reach): IMGFP_TRACE=file of "stemA stemB" lines.
+static TRACE_WINDOWS: std::sync::Mutex<Vec<(usize, usize)>> = std::sync::Mutex::new(Vec::new());
+fn trace_pairs(files: &[PathBuf], pass: &Pass, index: &Index) {
+    let Ok(t) = std::env::var("IMGFP_TRACE") else { return };
+    let stem = |p: &PathBuf| p.file_stem().map(|s| s.to_string_lossy().into_owned()).unwrap_or_default();
+    let by: HashMap<String, usize> = files.iter().enumerate().map(|(i, p)| (stem(p), i)).collect();
+    let win = TRACE_WINDOWS.lock().unwrap().clone();
