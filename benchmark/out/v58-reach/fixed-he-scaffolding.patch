+/// SCAFFOLDING: weak geometric consistency of two files' shared words: the
+/// most shared-word keypoint pairs agreeing on one (rotation, scale) bin, each
+/// of A's keypoints counted once a bin.
+fn wgc(ga: &[(u8, u8)], wa: &WordList, gb: &[(u8, u8)], wb: &WordList) -> u32 {
+    thread_local!(static PAIRS: std::cell::RefCell<Vec<(u32, u32)>> = const { std::cell::RefCell::new(Vec::new()) });
+    PAIRS.with_borrow_mut(|pairs| {
+        index::shared(wa, wb, pairs, 60_000);
+        if pairs.len() < 3 {
+            return pairs.len() as u32;
+        }
+        // Rotation in 16ths of a turn, scale ratio in octaves (quarter-octave
+        // units / 4), 16 x 12 bins; each of A's keypoints once a bin.
+        let mut bins = [[0u32; 12]; 16];
+        let mut last = [[u32::MAX; 12]; 16];
+        let mut best = 0;
+        for &(ka, kb) in pairs.iter() {
+            let (a, b) = (ga[ka as usize], gb[kb as usize]);
+            let ab = (b.0.wrapping_sub(a.0) & 15) as usize;
+            let ds = (b.1 as i32 - a.1 as i32).div_euclid(4) + 6;
+            let sb = ds.clamp(0, 11) as usize;
+            if last[ab][sb] != ka {
+                last[ab][sb] = ka;
+                bins[ab][sb] += 1;
+                best = best.max(bins[ab][sb]);
+            }
+        }
+        best
+    })
+}
+
+/// SCAFFOLDING: each file's keypoints as (angle in 16ths of a turn, log2
+/// scale in quarter octaves), built once for the geometric window.
+static GEOM: std::sync::OnceLock<Vec<Vec<(u8, u8)>>> = std::sync::OnceLock::new();
+fn geom_of(items: &[Item]) -> &'static Vec<Vec<(u8, u8)>> {
+    GEOM.get_or_init(|| {
+        items
+            .par_iter()
+            .map(|it| it.feats.kps.iter().map(|k| (((k.angle.rem_euclid(360.0) / 22.5) as u8).min(15), ((k.sigma.max(1e-3).log2() * 4.0 + 64.0).clamp(0.0, 255.0)) as u8)).collect())
+            .collect()
+    })
+}
+
+/// SCAFFOLDING: IMGFP_GEO=M:W, the geometric window.
+fn geo_window() -> Option<(usize, usize)> {
+    static G: std::sync::OnceLock<Option<(usize, usize)>> = std::sync::OnceLock::new();
+    *G.get_or_init(|| {
+        let v = std::env::var("IMGFP_GEO").ok()?;
+        let (m, w) = v.split_once(':')?;
+        Some((m.parse().ok()?, w.parse().ok()?))
+    })
+}
+
+static GEO2_EXTRA: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+static GEO2_POS: [std::sync::atomic::AtomicU64; 5] = [const { std::sync::atomic::AtomicU64::new(0) }; 5];
+static GEO2_PEAK: [std::sync::atomic::AtomicU64; 16] = [const { std::sync::atomic::AtomicU64::new(0) }; 16];
+/// SCAFFOLDING: IMGFP_GEO2=M:W, the geometric look inside the second look.
+fn geo2_window() -> Option<(usize, usize)> {
+    static G: std::sync::OnceLock<Option<(usize, usize)>> = std::sync::OnceLock::new();
+    *G.get_or_init(|| {
+        let v = std::env::var("IMGFP_GEO2").ok()?;
+        let (m, w) = v.split_once(':')?;
+        Some((m.parse().ok()?, w.parse().ok()?))
+    })
+}
