+        let (rj, nj, sj, tj) = rank(j, i);
+        let mut wg = |x: usize, y: usize| {
+            let c = index.candidates(x, &[&index.lists()[x]], 3000, &mut a).to_vec();
+            let g = geom_of(pass.items);
+            let mut sc: Vec<(u32, u32)> = c.iter().map(|&(z, ..)| (wgc(&g[x], &index.lists()[x], &g[z as usize], &index.lists()[z as usize]), z)).collect();
+            let mine = sc.iter().find(|e| e.1 as usize == y).map(|e| e.0);
+            sc.sort_unstable_by(|a, b| b.0.cmp(&a.0).then(a.1.cmp(&b.1)));
