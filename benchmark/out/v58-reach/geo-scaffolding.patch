+// SCAFFOLDING (v58): the geometric look.
+static BEST_ALL: std::sync::OnceLock<Vec<WordList>> = std::sync::OnceLock::new();
+static GEO2_LOG: std::sync::OnceLock<Option<std::sync::Mutex<std::fs::File>>> = std::sync::OnceLock::new();
+static GEO2_EXTRA: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+static GEO2_POS: [std::sync::atomic::AtomicU64; 5] = [const { std::sync::atomic::AtomicU64::new(0) }; 5];
+static GEO2_PEAK: [std::sync::atomic::AtomicU64; 16] = [const { std::sync::atomic::AtomicU64::new(0) }; 16];
+fn geo2_window() -> Option<(usize, usize)> {
+    static G: std::sync::OnceLock<Option<(usize, usize)>> = std::sync::OnceLock::new();
+    *G.get_or_init(|| {
+        let v = std::env::var("IMGFP_GEO2").ok()?;
+        let (m, w) = v.split_once(':')?;
+        Some((m.parse().ok()?, w.parse().ok()?))
+    })
+}
+
+/// Each file's keypoints as (angle in 16ths of a turn, log2 scale in
+/// quarter octaves), built once for the geometric look.
+static GEOM: std::sync::OnceLock<Vec<Vec<(u8, u8)>>> = std::sync::OnceLock::new();
+fn geom_of(items: &[Item]) -> &'static Vec<Vec<(u8, u8)>> {
+    GEOM.get_or_init(|| {
+        items
+            .par_iter()
+            .map(|it| it.feats.kps.iter().map(|k| (((k.angle.rem_euclid(360.0) / 22.5) as u8).min(15), ((k.sigma.max(1e-3).log2() * 4.0 + 64.0).clamp(0.0, 255.0)) as u8)).collect())
+            .collect()
+    })
+}
+
+/// Weak geometric consistency of two files' shared words: the most
+/// shared-word keypoint pairs agreeing on one (rotation, scale) bin, each of
+/// A's keypoints counted once a bin.
+fn wgc(ga: &[(u8, u8)], wa: &WordList, gb: &[(u8, u8)], wb: &WordList) -> u32 {
+    thread_local!(static PAIRS: std::cell::RefCell<Vec<(u32, u32)>> = const { std::cell::RefCell::new(Vec::new()) });
+    PAIRS.with_borrow_mut(|pairs| {
+        index::shared(wa, wb, pairs, 60_000);
+        if pairs.len() < 3 {
+            return pairs.len() as u32;
+        }
+        let mut bins = [[0u32; 12]; 16];
+        let mut last = [[u32::MAX; 12]; 16];
+        let mut best = 0;
+        for &(ka, kb) in pairs.iter() {
+            let (a, b) = (ga[ka as usize], gb[kb as usize]);
+            let ab = (b.0.wrapping_sub(a.0) & 15) as usize;
+            let ds = (b.1 as i32 - a.1 as i32).div_euclid(4) + 6;
+            let sb = ds.clamp(0, 11) as usize;
+            if last[ab][sb] != ka {
+                last[ab][sb] = ka;
+                bins[ab][sb] += 1;
+                best = best.max(bins[ab][sb]);
+            }
+        }
+        best
+    })
+}
+
+/// One asker's words and keypoint geometry, for scoring candidates' weak
+/// geometric consistency (`peak`) without building their shared pairs.
+struct Asker {
+    has: Vec<u64>,
+    words: Vec<u32>,
+    geo: Vec<(u8, u8)>,
+    kps: Vec<u32>,
+}
+
+impl Asker {
+    fn new(wl: &WordList, g: &[(u8, u8)]) -> Asker {
+        let top = (0..wl.len()).map(|e| wl.word(e)).max().unwrap_or(0) as usize;
+        let mut has = vec![0u64; top / 64 + 1];
+        let (mut words, mut geo, mut kps) = (Vec::with_capacity(wl.len()), Vec::with_capacity(wl.len()), Vec::with_capacity(wl.len()));
+        for e in 0..wl.len() {
+            let w = wl.word(e);
+            has[w as usize / 64] |= 1 << (w % 64);
+            words.push(w);
+            geo.push(g[wl.kp(e) as usize]);
+            kps.push(wl.kp(e));
+        }
+        Asker { has, words, geo, kps }
+    }
+
+    /// The most of the asker's keypoints agreeing on one (rotation, scale)
+    /// bin with a candidate keypoint sharing their word.
+    fn peak(&self, wl: &WordList, g: &[(u8, u8)]) -> u32 {
+        let mut bins = [[0u16; 12]; 16];
+        let mut last = [[u32::MAX; 12]; 16];
+        let mut best = 0u16;
+        let mut at = 0usize;
+        let n = self.has.len() * 64;
+        for e in 0..wl.len() {
+            let w = wl.word(e);
+            if w as usize >= n || self.has[w as usize / 64] >> (w % 64) & 1 == 0 {
+                continue;
+            }
+            while self.words[at] < w {
+                at += 1;
+            }
+            let b = g[wl.kp(e) as usize];
+            let mut x = at;
+            while x < self.words.len() && self.words[x] == w {
+                let a = self.geo[x];
+                let ab = (b.0.wrapping_sub(a.0) & 15) as usize;
+                let sb = ((b.1 as i32 - a.1 as i32).div_euclid(4) + 6).clamp(0, 11) as usize;
+                let ka = self.kps[x];
+                if last[ab][sb] != ka {
+                    last[ab][sb] = ka;
+                    bins[ab][sb] += 1;
+                    best = best.max(bins[ab][sb]);
+                }
+                x += 1;
+            }
+        }
+        best as u32
+    }
+}
