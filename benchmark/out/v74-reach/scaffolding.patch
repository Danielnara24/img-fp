+/// A keypoint as `agree` reads it: place in eighths of a working pixel,
+/// angle in 65,536ths of a turn, log2 scale in 256ths of an octave.
+#[derive(Clone, Copy, Default)]
+struct Pt {
+    x: u16,
+    y: u16,
+    angle: u16,
+    scale: i16,
+}
+
+impl Pt {
+    fn new(k: &crate::sift::Keypoint) -> Pt {
+        Pt {
+            x: (k.x * 8.0).round().clamp(0.0, 65535.0) as u16,
+            y: (k.y * 8.0).round().clamp(0.0, 65535.0) as u16,
+            angle: ((k.angle.rem_euclid(360.0) / 360.0 * 65536.0) as u32 & 0xffff) as u16,
+            scale: (k.sigma.max(1e-3).log2() * 256.0).round().clamp(-32768.0, 32767.0) as i16,
+        }
+    }
+
+    #[inline(always)]
+    fn place(&self, _wh: (u16, u16)) -> (f32, f32) {
+        (self.x as f32 / 8.0, self.y as f32 / 8.0)
+    }
 }
 
