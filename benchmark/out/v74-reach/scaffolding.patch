+/// Transform agreement among two files' seeds (keypoint pairs sharing a
+/// word): each seed read as a similarity from its keypoints' place, angle
+/// and scale, and the most of `a`'s keypoints another seed puts within the
+/// inlier tolerance of where that similarity carries them. Verification's
+/// first step (`verify::best_transform`) on the seeds themselves, from
+/// positions held in the index rather than the analysis.
+fn agree(seeds: &[(u32, u32)], a: &Shape, b: &Shape, need: u32) -> u32 {
+    // Seeds come sorted by `a`'s keypoint: the distinct ones bound any count.
+    let mut distinct = 0u32;
+    let mut prev = u32::MAX;
+    for &(p, _) in seeds {
+        distinct += (p != prev) as u32;
+        prev = p;
+    }
+    if distinct < need.max(LEAST_PEAK) {
+        return 0;
+    }
+    let (bw, bh) = (b.wh.0 as f32, b.wh.1 as f32);
+    let tol = (0.015 * (bw * bw + bh * bh).sqrt()).max(3.0);
+    let tol2 = tol * tol;
+    let pa = |k: u32| a.pts[k as usize].place(a.wh);
+    let pb = |k: u32| b.pts[k as usize].place(b.wh);
+    let mut best = 0u32;
+    for &(i, j) in seeds.iter().take(600) {
+        let (ka, kb) = (&a.pts[i as usize], &b.pts[j as usize]);
+        let s = ((kb.scale as f32 - ka.scale as f32) / 256.0).exp2();
+        let t = (kb.angle.wrapping_sub(ka.angle)) as f32 * (std::f32::consts::TAU / 65536.0);
+        let (c, sn) = (s * t.cos(), s * t.sin());
+        let (ax, ay) = pa(i);
+        let (bx, by) = pb(j);
+        let mut n = 0u32;
+        // What is left to count can still lift `n` by at most the distinct
+        // keypoints not yet passed.
+        let mut left = distinct;
+        let mut last = u32::MAX;
+        let mut prev = u32::MAX;
+        for &(p, q) in seeds {
+            if p != prev {
+                left -= 1;
+                prev = p;
+            }
+            if p == last {
+                continue;
+            }
+            let (x, y) = pa(p);
+            let (dx, dy) = (x - ax, y - ay);
+            let (u, v) = (bx + c * dx - sn * dy, by + sn * dx + c * dy);
+            let (qx, qy) = pb(q);
+            if (u - qx) * (u - qx) + (v - qy) * (v - qy) <= tol2 {
+                n += 1;
+                last = p;
+            } else if n + left + 1 <= best.max(need - 1) {
+                // Even this keypoint and every one left agreeing could not
+                // beat the best, nor reach `need`.
+                break;
+            }
+        }
+        best = best.max(n);
+    }
+    best
+}
