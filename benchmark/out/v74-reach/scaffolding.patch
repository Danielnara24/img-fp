+/// SCAFFOLDING (v74 trace): ancestor maps 1-3 levels up, by word.
+pub(crate) static ANC: std::sync::OnceLock<Vec<Vec<u32>>> = std::sync::OnceLock::new();
+
+/// SCAFFOLDING (v74 trace): `wl` with each word mapped, re-sorted, deduped.
+fn remap(wl: &WordList, map: &[u32]) -> WordList {
+    let mut p: Vec<(u32, u32)> = (0..wl.len()).map(|e| (map[wl.word(e) as usize], wl.kp(e))).collect();
+    p.sort_unstable();
+    p.dedup();
+    WordList::from_sorted(&p)
+}
+
+/// SCAFFOLDING (v74 trace): mutual nearest pairs within 320 among `pairs`.
+fn mutual(a: &Features, b: &Features, pairs: &[(u32, u32)]) -> usize {
+    use std::collections::HashMap;
+    let d2 = |i: u32, j: u32| a.d(i as usize).iter().zip(b.d(j as usize)).map(|(&x, &y)| { let d = x as i32 - y as i32; (d * d) as u32 }).sum::<u32>();
+    let (mut ba, mut bb): (HashMap<u32, (u32, u32)>, HashMap<u32, (u32, u32)>) = Default::default();
+    for &(i, j) in pairs {
+        let d = d2(i, j);
+        let e = ba.entry(i).or_insert((u32::MAX, 0));
+        if d < e.0 { *e = (d, j); }
+        let e = bb.entry(j).or_insert((u32::MAX, 0));
+        if d < e.0 { *e = (d, i); }
+    }
+    ba.iter().filter(|(i, (d, j))| *d <= 320 * 320 && bb.get(j).map(|x| x.1) == Some(**i)).count()
+}
