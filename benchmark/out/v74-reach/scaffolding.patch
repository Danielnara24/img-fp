+                let v = crate::verify::verify(&p, &sh, Variant::SAME, (3, 0.0), &mut mt, &mut sc);
+                out += &format!(" up{u} seeds={} nn={nn} peak={peak} null={null} pr1k={r1} pr5k={r5} vin={} vblk={:.3} vov={:.3} vmatch={}", sh.len(), v.n_in, v.blk, v.ov_a.max(v.ov_b), v.n_match);
+            }
+        }
+        out
+    }
+}
