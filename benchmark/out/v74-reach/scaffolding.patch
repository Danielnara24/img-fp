+/// SCAFFOLDING (v74 oracle): for each traced pair's query, every file's
+/// count of query keypoints with a descriptor within T sharing an ancestor
+/// cell at level <= L; the true reference's count and its place.
+impl Index<'_> {
+    pub(crate) fn oracle(&self) {
+        use crate::index::dist2;
+        let Some(t) = TRACE.get() else { return };
+        let shapes = self.shapes.as_ref().expect("shapes");
+        let anc = ANC.get().unwrap();
+        const TS: [u32; 6] = [200, 240, 280, 320, 360, 400];
+        const NC: usize = 24;
+        let tmax = TS[5] * TS[5];
+        let n_cells = anc[2].iter().copied().max().unwrap_or(0) as usize + 1;
+        let mut cells: Vec<Vec<(u16, u16, u32)>> = vec![Vec::new(); n_cells];
+        let qdesc: Vec<Vec<u8>> = t.iter().map(|(q, ..)| { let f = &self.items[*q].feats; (0..f.len()).flat_map(|i| f.d(i).iter().copied()).collect() }).collect();
+        for (qi, (q, ..)) in t.iter().enumerate() {
+            let wl = &self.lists[*q];
+            for e in 0..wl.len() {
+                let w = wl.word(e);
+                cells[anc[2][w as usize] as usize].push((qi as u16, wl.kp(e) as u16, w));
+            }
+        }
+        eprintln!("ORACLE cells {n_cells} entries {}", cells.iter().map(|c| c.len()).sum::<usize>());
+        let level = |a: u32, b: u32| -> u8 {
+            if a == b { 0 } else if anc[0][a as usize] == anc[0][b as usize] { 1 } else if anc[1][a as usize] == anc[1][b as usize] { 2 } else { 3 }
+        };
+        let counts = |m: &[(u16, u8, u32)]| -> [u16; NC] {
+            // m: one query's matches (kq, level, d2), sorted by kq.
+            let mut c = [0u16; NC];
+            let mut at = 0;
+            while at < m.len() {
+                let mut end = at;
+                let mut best = [u32::MAX; 4];
+                while end < m.len() && m[end].0 == m[at].0 {
+                    for l in m[end].1 as usize..4 { best[l] = best[l].min(m[end].2); }
+                    end += 1;
+                }
+                for l in 0..4 { for (ti, &tt) in TS.iter().enumerate() { if best[l] <= tt * tt { c[l * 6 + ti] += 1; } } }
+                at = end;
+            }
+            c
+        };
+        const NA: usize = 12;
+        const AT: [u32; 3] = [280, 320, 400];
+        type Acc = (Vec<[[u32; 64]; NC]>, Vec<[u16; NC]>, Vec<[[u32; 64]; NA]>, Vec<[u16; NA]>);
+        let zero = || -> Acc { (vec![[[0u32; 64]; NC]; t.len()], vec![[0u16; NC]; t.len()], vec![[[0u32; 64]; NA]; t.len()], vec![[0u16; NA]; t.len()]) };
+        let (hist, truth, ahist, atruth) = (0..self.items.len()).into_par_iter().fold(zero, |mut acc: Acc, j| {
+            if !self.matched[j] { return acc }
+            let wl = &shapes[j].best;
+            let f = &self.items[j].feats;
+            let mut m: Vec<(u16, u16, u16, u8, u32)> = Vec::new();
+            let mut seeds: Vec<(u32, u32)> = Vec::new();
+            for e in 0..wl.len() {
+                let w = wl.word(e);
+                let b = &cells[anc[2][w as usize] as usize];
+                if b.is_empty() { continue }
+                let d: &[u8; 128] = f.d(wl.kp(e) as usize).try_into().unwrap();
+                for &(qi, kq, wq) in b {
+                    let d2 = dist2(d, &qdesc[qi as usize][kq as usize * 128..kq as usize * 128 + 128]);
+                    if d2 <= tmax { m.push((qi, kq, wl.kp(e) as u16, level(w, wq), d2)); }
+                }
+            }
+            m.sort_unstable();
+            let mut at = 0;
+            let mut one: Vec<(u16, u8, u32)> = Vec::new();
+            while at < m.len() {
+                let qi = m[at].0 as usize;
+                one.clear();
+                let from = at;
+                while at < m.len() && m[at].0 as usize == qi { one.push((m[at].1, m[at].3, m[at].4)); at += 1; }
+                if t[qi].0 == j { continue }
+                let c = counts(&one);
+                for x in 0..NC { acc.0[qi][x][(c[x] as usize).min(63)] += 1; }
+                if t[qi].1 == j { acc.1[qi] = c; }
+                for l in 0..4usize { for (ti, &tt) in AT.iter().enumerate() {
+                    seeds.clear();
+                    seeds.extend(m[from..at].iter().filter(|x| x.3 as usize <= l && x.4 <= tt * tt).map(|x| (x.1 as u32, x.2 as u32)));
+                    seeds.dedup();
+                    let g = if seeds.len() >= 3 { agree(&seeds, &shapes[t[qi].0], &shapes[j], 1) } else { 0 };
+                    acc.2[qi][l * 3 + ti][(g as usize).min(63)] += 1;
+                    if t[qi].1 == j { acc.3[qi][l * 3 + ti] = g as u16; }
+                } }
+            }
+            acc
+        }).reduce(zero, |mut a, b| {
+            for q in 0..a.0.len() { for x in 0..NC { for h in 0..64 { a.0[q][x][h] += b.0[q][x][h]; } a.1[q][x] = a.1[q][x].max(b.1[q][x]); } }
+            for q in 0..a.2.len() { for x in 0..NA { for h in 0..64 { a.2[q][x][h] += b.2[q][x][h]; } a.3[q][x] = a.3[q][x].max(b.3[q][x]); } }
+            a
+        });
+        for (qi, (q, r, name)) in t.iter().enumerate() {
+            let mut out = format!("ORACLE {name}");
+            for x in 0..NC {
+                let tc = truth[qi][x] as usize;
+                let above: u32 = hist[qi][x][(tc + 1).min(64)..].iter().sum();
+                let ties = hist[qi][x][tc.min(63)];
+                let top = (1..64).rev().find(|&h| hist[qi][x][h] > 0).unwrap_or(0);
+                out += &format!(" L{}T{}={tc}/{above}/{ties}/{top}", x / 6, TS[x % 6]);
+            }
+            for x in 0..NA {
+                let tc = atruth[qi][x] as usize;
+                let above: u32 = ahist[qi][x][(tc + 1).min(64)..].iter().sum();
+                let ties = ahist[qi][x][tc.min(63)];
+                let top = (1..64).rev().find(|&h| ahist[qi][x][h] > 0).unwrap_or(0);
+                out += &format!(" L{}A{}={tc}/{above}/{ties}/{top}", x / 3, AT[x % 3]);
+            }
+            // The pair's own seeds under each bar, verified.
+            let (fa, fb) = (&self.items[*q].feats, &self.items[*r].feats);
+            let (la, lb) = (&self.lists[*q], &shapes[*r].best);
+            let mut all: Vec<(u32, u32, u8, u32)> = Vec::new();
+            for ea in 0..la.len() { for eb in 0..lb.len() {
+                let (wa, wb) = (la.word(ea), lb.word(eb));
+                if anc[2][wa as usize] != anc[2][wb as usize] { continue }
+                let d2 = dist2(fb.d(lb.kp(eb) as usize).try_into().unwrap(), fa.d(la.kp(ea) as usize));
+                if d2 <= tmax { all.push((la.kp(ea), lb.kp(eb), level(wa, wb), d2)); }
+            } }
+            all.sort_unstable();
+            let p = crate::verify::Pair { fa, fb, ta: &self.items[*q].thumb, tb: &self.items[*r].thumb };
+            let (mut mt, mut sc) = (Vec::new(), crate::verify::Scratch::default());
+            let mut ver = |tag: &str, seeds: &[(u32, u32)], out: &mut String| {
+                let v = crate::verify::verify(&p, seeds, Variant::SAME, (3, 0.0), &mut mt, &mut sc);
+                *out += &format!(" V{tag}={}/{}/{:.3}/{:.3}", seeds.len(), v.n_in, v.blk, v.ov_a.max(v.ov_b));
+            };
+            for l in 0..4u8 { for tt in [240u32, 320, 400] {
+                let mut s: Vec<(u32, u32)> = all.iter().filter(|m| m.2 <= l && m.3 <= tt * tt).map(|m| (m.0, m.1)).collect();
+                s.dedup();
+                ver(&format!("L{l}T{tt}"), &s, &mut out);
+            } }
+            // Brute force: every pair within 400, and the mutual nearest.
+            let mut bf: Vec<(u32, u32, u32)> = Vec::new();
+            for i in 0..fa.len() { for j in 0..fb.len() {
+                let d2 = dist2(fa.d(i).try_into().unwrap(), fb.d(j));
+                if d2 <= tmax { bf.push((i as u32, j as u32, d2)); }
+            } }
+            for tt in [240u32, 320, 400] {
+                let s: Vec<(u32, u32)> = bf.iter().filter(|m| m.2 <= tt * tt).map(|m| (m.0, m.1)).collect();
+                ver(&format!("BF{tt}"), &s, &mut out);
+            }
+            eprintln!("{out}");
+        }
+    }
+}
