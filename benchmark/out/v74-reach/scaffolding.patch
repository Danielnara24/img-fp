+/// Transform agreement by vote: each seed read as a similarity puts the
+/// asker's frame centre somewhere in the candidate, and votes for that place
+/// (an eighth of the candidate's diagonal a cell, each way and its nearer
+/// neighbour) at its rotation (16ths of a turn) and scale (octaves); the
+/// most distinct asker keypoints in one cell.
+#[derive(Default)]
+struct Votes {
+    slots: Vec<(u32, u32, u32)>,
+    used: Vec<usize>,
+}
+
+impl Votes {
+    const EMPTY: u32 = u32::MAX;
+
+    fn most(&mut self, seeds: &[(u32, u32)], a: &Shape, b: &Shape) -> u32 {
+        if seeds.len() < LEAST_PEAK as usize {
+            return 0;
+        }
+        let size = (seeds.len() * 32).next_power_of_two().max(64);
+        if self.slots.len() < size {
+            self.slots = vec![(Self::EMPTY, 0, 0); size];
+        }
+        let mask = size - 1;
+        let (cx, cy) = (a.wh.0 as f32 / 2.0, a.wh.1 as f32 / 2.0);
+        let (bw, bh) = (b.wh.0 as f32, b.wh.1 as f32);
+        let cell = ((bw * bw + bh * bh).sqrt() / 4.0).max(8.0);
+        let mut best = 0u32;
+        for &(p, q) in seeds {
+            let (ka, kb) = (&a.pts[p as usize], &b.pts[q as usize]);
+            let dscale = (kb.scale as i32 - ka.scale as i32) as f32 / 256.0;
+            let turn = kb.angle.wrapping_sub(ka.angle);
+            let s = dscale.exp2();
+            let t = turn as f32 * (std::f32::consts::TAU / 65536.0);
+            let (c, sn) = (s * t.cos(), s * t.sin());
+            let (ax, ay) = ka.place(a.wh);
+            let (bx, by) = kb.place(b.wh);
+            let (dx, dy) = (cx - ax, cy - ay);
+            let (u, v) = ((bx + c * dx - sn * dy) / cell, (by + sn * dx + c * dy) / cell);
+            if !(u.abs() < 1000.0 && v.abs() < 1000.0) {
+                continue;
+            }
+            let (ux, vy) = (u.floor(), v.floor());
+            let nx = if u - ux < 0.5 { ux - 1.0 } else { ux + 1.0 };
+            let ny = if v - vy < 0.5 { vy - 1.0 } else { vy + 1.0 };
+            // Rotation in eighths and scale in octaves, each with its nearer
+            // neighbour: a seed votes in sixteen cells.
+            let r = turn as u32 * 8;
+            let rot = r >> 16;
+            let rn = if (r & 0xffff) < 0x8000 { (rot + 7) & 7 } else { (rot + 1) & 7 };
+            let o = dscale.floor();
+            let oct = ((o as i32).clamp(-8, 7) + 8) as u32;
+            let on = if dscale - o < 0.5 { oct.saturating_sub(1) } else { (oct + 1).min(15) };
+            for rr in [rot, rn] {
+                for oo in [oct, on] {
+                    for (x, y) in [(ux, vy), (nx, vy), (ux, ny), (nx, ny)] {
+                        let key = rr | oo << 3 | (((x as i32 + 1024) as u32) & 2047) << 7 | (((y as i32 + 1024) as u32) & 2047) << 18;
+                        let mut h = (key.wrapping_mul(0x9e37_79b1) >> 7) as usize & mask;
+                        loop {
+                            let e = &mut self.slots[h];
+                            if e.0 == Self::EMPTY {
+                                *e = (key, 1, p);
+                                self.used.push(h);
+                                best = best.max(1);
+                                break;
+                            }
+                            if e.0 == key {
+                                if e.2 != p {
+                                    e.1 += 1;
+                                    e.2 = p;
+                                    best = best.max(e.1);
+                                }
+                                break;
+                            }
+                            h = (h + 1) & mask;
+                        }
+                    }
+                }
+            }
+        }
+        for &h in &self.used {
+            self.slots[h] = (Self::EMPTY, 0, 0);
+        }
+        self.used.clear();
+        best
+    }
+}
