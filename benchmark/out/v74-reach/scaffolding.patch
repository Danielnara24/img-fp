+/// SCAFFOLDING (v74): ask for the first `lines` cache lines of `v`.
+fn prefetch_run<T>(v: &[T], lines: usize) {
+    #[cfg(target_arch = "x86_64")]
+    unsafe {
+        use std::arch::x86_64::{_mm_prefetch, _MM_HINT_T0};
+        let p = v.as_ptr() as *const i8;
+        let bytes = std::mem::size_of_val(v);
+        let mut at = 0;
+        while at < bytes && at < lines * 64 {
+            _mm_prefetch(p.add(at), _MM_HINT_T0);
+            at += 64;
+        }
+    }
+}
